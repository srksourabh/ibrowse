# Copy to .env.local (or .env) and fill in. Both are git-ignored and never committed.
# Server-side Gemini Live Token Service configuration (NEVER embed in extension builds):
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_LIVE_MODEL=models/gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_LIVE_TOKEN_TTL=600
GEMINI_LIVE_NEW_SESSION_TTL=120
GEMINI_LIVE_TOKEN_SERVICE_ENABLED=true
IBROWSE_TOKEN_SIGNING_SECRET=
IBROWSE_REGISTER_RATE_LIMIT_PER_MIN=10
IBROWSE_TOKEN_RATE_LIMIT_PER_MIN=20
IBROWSE_TOKEN_DAILY_QUOTA=200
IBROWSE_GLOBAL_TOKEN_RATE_LIMIT_PER_MIN=120
# Optional comma-separated allowed origins (e.g. chrome-extension://<extension-id>):
IBROWSE_ALLOWED_ORIGINS=
